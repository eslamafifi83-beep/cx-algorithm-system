{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "images": {
    "sizes": [64, 128, 256, 384, 640, 828, 1080, 1600, 2048],
    "domains": ["fuuuhcvwlrfenjfpcymy.supabase.co"],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400
  },
  "redirects": [
    { "source": "/lib/:path*", "destination": "/", "permanent": false },
    { "source": "/templates/:path*", "destination": "/episodes", "permanent": false }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/episode", "destination": "/api/episode-page" },
    { "source": "/episodes/:slug", "destination": "/api/episode-page?slug=:slug" }
  ],
  "functions": {
    "api/episode-page.js": { "includeFiles": "{templates/**,404.html}" }
  }
}
